<div class="container mt-4">
  <div class="row">
    <% @posts.each do |post| %>
      <div class="col-md-4 mb-4">
        <div class="card">
          <div class="card-body">
          <% if post.profile_picture.attached? %>
             <%= image_tag post.profile_picture, class: "img-fluid" %> 
          <% end %>
          <h5 class="card-title"><%= post.postname %></h5>
          <p class="card-text">Some additional information about the post can go here.</p>
          <%= button_to 'Delete Post', user_post_path(current_user, post), method: :delete, data: { confirm: 'Are you sure you want to delete this post?' }, class: 'btn btn-danger' %>

          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
